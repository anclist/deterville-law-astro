---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@atoms/Container.astro';
import Button from '@atoms/Button.astro';
import SectionHeading from '@molecules/SectionHeading.astro';
import HomeHero from '@organisms/HomeHero.astro';
import PracticeList from '@organisms/PracticeList.astro';
import Journey from '@organisms/Journey.astro';
import TestimonialGrid from '@organisms/TestimonialGrid.astro';
import ConsultSteps from '@organisms/ConsultSteps.astro';
import FaqList from '@organisms/FaqList.astro';
import PostGrid from '@organisms/PostGrid.astro';
import CtaBand from '@organisms/CtaBand.astro';
import { firm } from '@data/site';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
---
<BaseLayout title={firm.name}>
  <HomeHero />
  <PracticeList />
  <Journey />
  <TestimonialGrid />
  <ConsultSteps />
  <FaqList />
  <section class="latest" aria-labelledby="latest-title">
    <Container>
      <SectionHeading id="latest-title" title="Recent updates" lede="Plain-language notes on changes to Canadian immigration and estate law." />
      <PostGrid posts={posts} />
      <div class="more"><Button href="/blog" variant="secondary">See all posts</Button></div>
    </Container>
  </section>
  <CtaBand />
</BaseLayout>

<style>
  .latest { padding-block: var(--layout-section-y); border-top: 1px solid var(--color-border); }
  .more { margin-top: var(--space-7); }
</style>
