---
import BaseLayout from '@layouts/BaseLayout.astro';
import HomeHero from '@organisms/HomeHero.astro';
import ServiceColumns from '@organisms/ServiceColumns.astro';
import RouteTimeline from '@organisms/RouteTimeline.astro';
import QuoteRow from '@organisms/QuoteRow.astro';
import BookingFaq from '@organisms/BookingFaq.astro';
import CtaBand from '@organisms/CtaBand.astro';
import { firm } from '@data/site';
---
<BaseLayout title={firm.name}>
  <HomeHero />
  <ServiceColumns />
  <RouteTimeline />
  <QuoteRow />
  <div class="rule" role="presentation"></div>
  <BookingFaq />
  <CtaBand tone="quiet" title="Ready to talk about your situation?" body="Book a consultation online, or call us." />
</BaseLayout>

<style>
  .rule { max-width: var(--layout-container); margin-inline: auto; border-top: 1px solid var(--color-border); }
</style>
