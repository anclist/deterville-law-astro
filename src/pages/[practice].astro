---
/** Practice area pages: /immigration, /wills-estates, /notarial-services */
import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@atoms/Container.astro';
import Button from '@atoms/Button.astro';
import Icon from '@atoms/Icon.astro';
import RatingBadge from '@molecules/RatingBadge.astro';
import PageHero from '@organisms/PageHero.astro';
import ConsultSteps from '@organisms/ConsultSteps.astro';
import TestimonialGrid from '@organisms/TestimonialGrid.astro';
import Journey from '@organisms/Journey.astro';
import FaqList from '@organisms/FaqList.astro';
import CtaBand from '@organisms/CtaBand.astro';
import { practices, firm, type Practice } from '@data/site';

export function getStaticPaths() {
  return practices.map((practice) => ({ params: { practice: practice.slug }, props: { practice } }));
}
const { practice } = Astro.props as { practice: Practice };
const others = practices.filter((p) => p.slug !== practice.slug);
---
<BaseLayout title={`${practice.title} Lawyer in Toronto`} description={practice.summary}>
  <PageHero title={practice.title} lede={practice.summary}>
    <Button href={firm.bookHref} size="lg">Book a consultation</Button>
    <Button href={firm.phoneHref} variant="ghost" icon="phone" size="lg">{firm.phone}</Button>
  </PageHero>

  <section class="detail">
    <Container class="detail__grid">
      <div>
        <h2>What we help with</h2>
        <ul class="checks">
          {practice.helpsWith.map((item) => <li><Icon name="check" size={20} />{item}</li>)}
        </ul>
      </div>
      <aside class="aside" aria-label="Who this is for">
        <h2>Who it’s for</h2>
        <p>{practice.forWhom}</p>
        <RatingBadge />
        <Button href={firm.bookHref} block>Book a consultation</Button>
        <p class="small">Or <a href={firm.whatsappHref} target="_blank" rel="noopener">message us on WhatsApp</a>.</p>
      </aside>
    </Container>
  </section>

  {practice.slug === 'immigration' && <Journey />}
  <ConsultSteps />
  <TestimonialGrid />
  <FaqList />

  <section class="others" aria-labelledby="others-title">
    <Container>
      <h2 id="others-title">Other ways we can help</h2>
      <ul>
        {others.map((p) => (
          <li><a href={p.href}><strong>{p.title}</strong><span>{p.short}</span></a></li>
        ))}
      </ul>
    </Container>
  </section>
  <CtaBand />
</BaseLayout>

<style>
  .detail { padding-block: var(--layout-section-y); }
  .detail :global(.detail__grid) { display: grid; gap: var(--space-8); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 60rem) { .detail :global(.detail__grid) { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); align-items: start; } }
  h2 { font-size: var(--size-3); margin-bottom: var(--space-5); }
  .checks { list-style: none; padding: 0; display: grid; gap: var(--space-4); }
  .checks li { display: flex; gap: var(--space-3); font-size: var(--size-1); line-height: var(--leading-snug); padding-bottom: var(--space-4); border-bottom: 1px solid var(--color-border); }
  .checks :global(.icon) { color: var(--color-action); margin-top: 0.15em; }
  .aside { display: grid; gap: var(--space-5); padding: var(--space-6); border-radius: var(--radius-md); background: var(--color-surface-tint); border: 1px solid var(--oxblood-100); position: sticky; top: 6.5rem; }
  .aside h2 { font-size: var(--size-2); margin: 0; }
  .small { font-size: var(--size--1); color: var(--color-text-muted); }
  .others { padding-block: var(--space-8); border-top: 1px solid var(--color-border); }
  .others h2 { font-size: var(--size-2); }
  .others ul { list-style: none; padding: 0; display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); }
  .others a { display: grid; gap: var(--space-1); padding: var(--space-5); border: 1.5px solid var(--color-border-strong); border-radius: var(--radius-md); text-decoration: none; color: var(--color-text); }
  .others a:hover { border-color: var(--color-action); }
  .others strong { font-family: var(--font-heading); font-size: var(--size-1); color: var(--color-heading); }
  .others span { color: var(--color-text-muted); font-size: var(--size--1); }
</style>
