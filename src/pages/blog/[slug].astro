---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@atoms/Container.astro';
import Button from '@atoms/Button.astro';
import Tag from '@atoms/Tag.astro';
import Icon from '@atoms/Icon.astro';
import Prose from '@organisms/Prose.astro';
import PostGrid from '@organisms/PostGrid.astro';
import CtaBand from '@organisms/CtaBand.astro';
import { firm, practices } from '@data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: CollectionEntry<'blog'> };
const { Content } = await render(post);
const { title, description, date, category, image, imageAlt, source } = post.data;
const practice = practices.find((p) => (category === 'Immigration' ? p.slug === 'immigration' : p.slug === 'wills-estates'))!;
const related = (await getCollection('blog')).filter((p) => p.id !== post.id).slice(0, 2);
const fmt = date.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<BaseLayout title={title} description={description} image={image}>
  <article class="post">
    <Container class="post-grid">
      <div>
        <header class="head">
          <a class="back" href="/blog">All posts</a>
          <h1>{title}</h1>
          <div class="meta">
            <Tag tone={category === 'Immigration' ? 'immigration' : 'estates'}>{category}</Tag>
            <time datetime={date.toISOString()}>{fmt}</time>
          </div>
        </header>
        {image && <img class="cover" src={image} alt={imageAlt ?? ''} width="1280" height="800" />}
        <Prose><Content /></Prose>
        {source && (
          <p class="source"><a href={source} target="_blank" rel="noopener">Read the official announcement<Icon name="external" size={14} /></a></p>
        )}
        <p class="disclaimer">This post is general information, not legal advice. Every situation is different.</p>
      </div>

      <aside class="aside" aria-label={`Get help with ${practice.title.toLowerCase()}`}>
        <h2>Does this affect you?</h2>
        <p>{practice.short} Talk it through with Ms Deterville in a confidential consultation.</p>
        <Button href={firm.bookHref} block>Book a consultation</Button>
        <a href={practice.href} class="practice-link">About our {practice.title.toLowerCase()} practice</a>
      </aside>
    </Container>
  </article>

  {related.length > 0 && (
    <section class="related" aria-labelledby="related-title">
      <Container>
        <h2 id="related-title">Keep reading</h2>
        <PostGrid posts={related} />
      </Container>
    </section>
  )}
  <CtaBand />
</BaseLayout>

<style>
  .post { padding-block: var(--space-7) var(--layout-section-y); }
  .post :global(.post-grid) { display: grid; gap: var(--space-8); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 62rem) { .post :global(.post-grid) { grid-template-columns: minmax(0, 1fr) 20rem; gap: var(--space-9); align-items: start; } }
  .head { display: grid; gap: var(--space-4); margin-bottom: var(--space-6); max-width: var(--measure-prose); }
  .back { font-size: var(--size--1); font-weight: 600; }
  h1 { font-size: var(--size-5); letter-spacing: -0.015em; }
  .meta { display: flex; gap: var(--space-3); align-items: center; color: var(--color-text-muted); font-size: var(--size--1); }
  .cover { width: 100%; max-width: var(--measure-prose); aspect-ratio: 16 / 10; object-fit: cover; border-radius: var(--radius-md); margin-bottom: var(--space-7); }
  .source { margin-top: var(--space-6); }
  .source a { display: inline-flex; gap: var(--space-1); align-items: center; font-weight: 600; }
  .disclaimer { margin-top: var(--space-6); padding-top: var(--space-4); border-top: 1px solid var(--color-border); font-size: var(--size--1); color: var(--color-text-muted); max-width: var(--measure-prose); }
  .aside { position: sticky; top: 7rem; display: grid; gap: var(--space-4); padding: var(--space-6); background: var(--color-surface-tint); border: 1px solid var(--oxblood-100); border-radius: var(--radius-md); }
  .aside h2 { font-size: var(--size-2); }
  .aside p { color: var(--color-text-muted); }
  .practice-link { font-size: var(--size--1); font-weight: 600; }
  .related { padding-block: var(--space-8); border-top: 1px solid var(--color-border); }
  .related h2 { font-size: var(--size-3); margin-bottom: var(--space-6); }
</style>
