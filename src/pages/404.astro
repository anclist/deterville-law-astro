---
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@atoms/Button.astro';
import PageHero from '@organisms/PageHero.astro';
import { firm } from '@data/site';
---
<BaseLayout title="Page not found" noindex>
  <PageHero title="This page has moved or doesn’t exist." lede="Our site was rebuilt and some addresses changed. Try one of these instead.">
    <Button href="/">Go to the home page</Button>
    <Button href={firm.bookHref} variant="secondary">Book a consultation</Button>
    <Button href="/blog" variant="ghost">Browse the blog</Button>
  </PageHero>
</BaseLayout>
