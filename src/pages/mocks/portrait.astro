---
/**
 * Mock C — "Portrait". A one-lawyer practice, so the page leads with the lawyer: her photograph
 * and her own route to Canada. Everything after the opening is short and plainly set.
 */
import MockLayout from '@layouts/MockLayout.astro';
import { firm, practices, testimonials } from '@data/site';

const quote = testimonials.find((t) => t.name === 'Janice Suite')!;
---
<MockLayout title="C · Portrait" label="Mock C: Portrait">
  <header class="top wrap">
    <a href="/mocks/portrait"><img src="/images/logo.png" alt="Deterville Law Office" width="80" height="60" /></a>
    <nav aria-label="Main">
      <a href="/who-we-are">About</a>
      <a href="/testimonials">Reviews</a>
      <a href="/blog">Blog</a>
      <a href={firm.phoneHref}>{firm.phone}</a>
    </nav>
  </header>

  <main>
    <section class="hero wrap">
      <img class="photo" src="/images/nandi-deterville.jpg" alt="Nandi Deterville" width="899" height="1200" />
      <div class="text">
        <h1>Nandi Deterville</h1>
        <p class="role">Immigration and estate planning lawyer, Toronto</p>
        <p>
          Born and raised in Saint Lucia, called to the Bar in England, Saint Lucia and Ontario. Having lived in five
          countries other than her homeland, she has navigated each one’s immigration rules, and that experience shapes
          her work with people who want to make Canada their home.
        </p>
        <p>She also helps Ontario families put Wills and Powers of Attorney in place, and provides notarial services.</p>
        <a class="button" href={firm.bookHref}>Book a consultation</a>
      </div>
    </section>

    <section class="services wrap" aria-label="Services">
      {practices.map((p) => (
        <div>
          <h2><a href={p.href}>{p.title}</a></h2>
          <p>{p.short}</p>
        </div>
      ))}
    </section>

    <section class="quote" aria-label="Client review">
      <figure class="wrap">
        <blockquote>{quote.quote}</blockquote>
        <figcaption>{quote.name} · one of {firm.rating.count} reviews on {firm.rating.source}, rated {firm.rating.score}</figcaption>
      </figure>
    </section>
  </main>

  <footer class="foot wrap">
    <p>Consultations online, worldwide, or at {firm.address.line1}, {firm.address.city}.</p>
    <p><a href={`mailto:${firm.email}`}>{firm.email}</a> · <a href={firm.whatsappHref}>WhatsApp</a> · LSO no. {firm.lsoNumber} · <a href="/legal">Legal</a></p>
  </footer>
</MockLayout>

<style>
  .wrap { max-width: 68rem; margin-inline: auto; padding-inline: var(--layout-gutter); }
  a { color: var(--oxblood-700); text-underline-offset: 0.2em; }

  .top { display: flex; align-items: center; justify-content: space-between; gap: var(--space-5); padding-block: var(--space-5); flex-wrap: wrap; }
  .top nav { display: flex; gap: var(--space-5); font-size: var(--size--1); flex-wrap: wrap; }
  .top nav a { color: var(--ink-700); text-decoration: none; }
  .top nav a:hover { text-decoration: underline; }

  .hero { display: grid; grid-template-columns: 5fr 7fr; gap: var(--space-8); align-items: center; padding-block: var(--space-7) var(--space-9); }
  .photo { width: 100%; height: auto; aspect-ratio: 3 / 4; object-fit: cover; border-radius: var(--radius-sm); }
  h1 { font: 500 var(--size-5)/1.05 var(--font-serif); color: var(--oxblood-900); }
  .role { margin-top: var(--space-3); font-size: var(--size-1); color: var(--ink-500); }
  .text p:not(.role) { margin-top: var(--space-5); color: var(--ink-700); max-width: 52ch; }
  .button {
    display: inline-block; margin-top: var(--space-6); padding: 0.8rem 1.4rem; border-radius: var(--radius-sm);
    background: var(--oxblood-700); color: var(--paper); font-weight: 500; text-decoration: none;
  }
  .button:hover { background: var(--oxblood-800); }

  .services { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-7); padding-block: var(--space-8); border-top: 1px solid var(--ink-100); }
  .services h2 { font: 500 var(--size-2)/1.2 var(--font-serif); margin-bottom: var(--space-3); }
  .services h2 a { color: var(--ink-900); text-decoration: none; }
  .services h2 a:hover { color: var(--oxblood-700); text-decoration: underline; }
  .services p { color: var(--ink-700); }

  .quote { background: var(--oxblood-50); padding-block: var(--space-9); }
  .quote figure { max-width: 46rem; }
  blockquote { font: 500 var(--size-3)/1.3 var(--font-serif); color: var(--oxblood-900); }
  figcaption { margin-top: var(--space-5); color: var(--ink-500); font-size: var(--size--1); }

  .foot { padding-block: var(--space-7) var(--space-9); font-size: var(--size--1); color: var(--ink-500); display: grid; gap: var(--space-2); }

  @media (max-width: 48rem) {
    .hero { grid-template-columns: 1fr; gap: var(--space-6); padding-top: var(--space-4); }
    .photo { max-width: 20rem; }
    .services { grid-template-columns: 1fr; gap: var(--space-6); }
  }
</style>
