---
import MockLayout from '@layouts/MockLayout.astro';

const mocks = [
  {
    href: '/mocks/letter',
    name: 'A · Letter',
    body: 'One narrow column that reads like a letter from the office. Colour only on the logo, links and one button. Five short sections.',
  },
  {
    href: '/mocks/desk',
    name: 'B · Desk',
    body: 'Contact details and the booking button pinned on the left like a business card; services, reviews and booking steps on the right. Sans-serif throughout.',
  },
  {
    href: '/mocks/portrait',
    name: 'C · Portrait',
    body: 'Leads with Nandi: her photograph, her name and her route to Canada. Then three services and a single review. The shortest of the three.',
  },
  {
    href: '/',
    name: 'Current build',
    body: 'The full version for comparison: route-line band, path router, cards, FAQ and blog teaser.',
  },
];
---
<MockLayout title="Homepage directions" label="Index">
  <main class="wrap">
    <h1>Homepage directions</h1>
    <p>Three quieter alternatives to the current build. Same content and brand colours, much less on the page.</p>
    <ul>
      {mocks.map((m) => (
        <li><a href={m.href}>{m.name}</a><p>{m.body}</p></li>
      ))}
    </ul>
  </main>
</MockLayout>

<style>
  .wrap { max-width: 40rem; margin-inline: auto; padding: var(--space-9) var(--layout-gutter); }
  h1 { font: 500 var(--size-4)/1.15 var(--font-serif); color: var(--ink-900); }
  .wrap > p { margin-top: var(--space-4); color: var(--ink-700); }
  ul { list-style: none; padding: 0; margin-top: var(--space-7); }
  li { padding-block: var(--space-5); border-top: 1px solid var(--ink-100); }
  li a { font-weight: 600; color: var(--oxblood-700); }
  li p { margin-top: var(--space-2); color: var(--ink-700); }
</style>
