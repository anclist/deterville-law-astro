---
/**
 * Mock C2 — "Portrait, fuller". Mock C's lawyer-led opening, with the current build's persuasive
 * sections brought back in a plain form: the route to Canada as a quiet timeline, reviews, booking
 * steps, a short FAQ and a closing call to book. One accent colour, no dark bands, no motion.
 */
import MockLayout from '@layouts/MockLayout.astro';
import { firm, nav, practices, journey, steps, testimonials, faqs } from '@data/site';

const quotes = testimonials.filter((t) => ['Janice Suite', 'Jermael Syahungene', 'Karleen Greenidge'].includes(t.name));
---
<MockLayout title="C2 · Portrait, fuller" label="Mock C2: Portrait, fuller">
  <header class="top">
    <div class="wrap bar">
      <a href="/mocks/portrait-plus"><img src="/images/logo.png" alt="Deterville Law Office" width="80" height="60" /></a>
      <nav aria-label="Main">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
      <a class="button small" href={firm.bookHref}>Book a consultation</a>
    </div>
  </header>

  <main>
    <section class="hero wrap">
      <img class="photo" src="/images/nandi-deterville.jpg" alt="Nandi Deterville" width="899" height="1200" />
      <div class="text">
        <h1>Nandi Deterville</h1>
        <p class="role">Canadian immigration and Ontario estate planning lawyer, Toronto</p>
        <p>
          Born and raised in Saint Lucia, called to the Bar in England, Saint Lucia and Ontario. Having lived in five
          countries other than her homeland, she has navigated each one’s immigration rules, and that experience shapes
          her work with people who want to make Canada their home.
        </p>
        <p>She also helps Ontario families put Wills and Powers of Attorney in place, and provides notarial services.</p>
        <div class="actions">
          <a class="button" href={firm.bookHref}>Book a consultation</a>
          <a class="plain" href={firm.whatsappHref}>Message on WhatsApp</a>
        </div>
        <p class="trust">
          Rated {firm.rating.score} on {firm.rating.source} from {firm.rating.count} reviews ·
          Law Society of Ontario no. {firm.lsoNumber} · Consultations online, worldwide
        </p>
      </div>
    </section>

    <section class="block wrap" aria-labelledby="services">
      <h2 id="services">How we can help</h2>
      <div class="services">
        {practices.map((p) => (
          <div class="service">
            <h3><a href={p.href}>{p.title}</a></h3>
            <p>{p.short}</p>
            <ul>{p.helpsWith.slice(0, 3).map((h) => <li>{h}</li>)}</ul>
            <a href={p.href}>More on {p.title}</a>
          </div>
        ))}
      </div>
    </section>

    <section class="block tint" aria-labelledby="route">
      <div class="wrap">
        <h2 id="route">Her own route to Canada</h2>
        <p class="lede">Clients moving to Canada work with a lawyer who has made that move herself.</p>
        <ol class="route">
          {journey.map((j) => (
            <li><strong>{j.place}</strong><span>{j.detail}</span></li>
          ))}
        </ol>
        <p><a href="/who-we-are">Read her full biography</a></p>
      </div>
    </section>

    <section class="block wrap" aria-labelledby="reviews">
      <h2 id="reviews">What clients say</h2>
      <div class="quotes">
        {quotes.map((q) => (
          <figure>
            <blockquote>{q.quote}</blockquote>
            <figcaption><a href={q.href}>{q.name}, {q.source}</a></figcaption>
          </figure>
        ))}
      </div>
      <p><a href="/testimonials">Read all reviews</a></p>
    </section>

    <section class="block wrap split" aria-labelledby="start">
      <div>
        <h2 id="start">Booking takes three steps</h2>
        <ol class="steps">
          {steps.map((s) => <li><strong>{s.title}</strong><span>{s.body}</span></li>)}
        </ol>
      </div>
      <div>
        <h2>Common questions</h2>
        <div class="faq">
          {faqs.slice(0, 4).map((f) => (
            <details><summary>{f.q}</summary><p>{f.a}</p></details>
          ))}
        </div>
      </div>
    </section>

    <section class="close tint" aria-labelledby="close">
      <div class="wrap">
        <h2 id="close">Ready to talk about your situation?</h2>
        <div class="actions">
          <a class="button" href={firm.bookHref}>Book a consultation</a>
          <span>or call <a href={firm.phoneHref}>{firm.phone}</a></span>
        </div>
      </div>
    </section>
  </main>

  <footer class="foot wrap">
    <address>
      {firm.name}<br />{firm.address.line1}, {firm.address.line2}<br />{firm.address.city}
    </address>
    <p>
      <a href={firm.phoneHref}>{firm.phone}</a> · <a href={`mailto:${firm.email}`}>{firm.email}</a> ·
      <a href="/media">Media</a> · <a href="/legal">Legal &amp; privacy</a>
    </p>
  </footer>
</MockLayout>

<style>
  .wrap { max-width: 70rem; margin-inline: auto; padding-inline: var(--layout-gutter); }
  a { color: var(--oxblood-700); text-underline-offset: 0.2em; }
  h2 { font: 500 var(--size-3)/1.2 var(--font-serif); color: var(--ink-900); margin-bottom: var(--space-6); }
  p, li { color: var(--ink-700); }

  .button {
    display: inline-block; padding: 0.8rem 1.4rem; border-radius: var(--radius-sm);
    background: var(--oxblood-700); color: var(--paper); font-weight: 500; text-decoration: none; white-space: nowrap;
  }
  .button:hover { background: var(--oxblood-800); }
  .button.small { padding: 0.55rem 1rem; font-size: var(--size--1); }
  .actions { display: flex; align-items: center; gap: var(--space-5); flex-wrap: wrap; margin-top: var(--space-6); }
  .plain { font-weight: 500; }

  .top { border-bottom: 1px solid var(--ink-100); background: var(--paper); position: sticky; top: 0; z-index: 5; }
  .bar { display: flex; align-items: center; gap: var(--space-6); padding-block: var(--space-3); }
  .bar nav { display: flex; gap: var(--space-5); margin-left: auto; font-size: var(--size--1); white-space: nowrap; }
  .bar nav a { color: var(--ink-700); text-decoration: none; }
  .bar nav a:hover { color: var(--oxblood-700); text-decoration: underline; }

  .hero { display: grid; grid-template-columns: 5fr 7fr; gap: var(--space-8); align-items: center; padding-block: var(--space-8); }
  .photo { width: 100%; height: auto; aspect-ratio: 3 / 4; object-fit: cover; border-radius: var(--radius-sm); }
  h1 { font: 500 var(--size-5)/1.05 var(--font-serif); color: var(--oxblood-900); }
  .role { margin-top: var(--space-3); font-size: var(--size-1); color: var(--ink-500); }
  .text > p:not(.role) { margin-top: var(--space-5); max-width: 52ch; }
  .text > .trust { font-size: var(--size--1); color: var(--ink-500); }

  .block { padding-block: var(--space-9); }
  .tint { background: var(--oxblood-50); }

  .services { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-7); }
  .service { border-top: 2px solid var(--oxblood-700); padding-top: var(--space-5); }
  .service h3 { font: 500 var(--size-2)/1.2 var(--font-serif); margin-bottom: var(--space-3); }
  .service h3 a { color: var(--ink-900); text-decoration: none; }
  .service ul { margin: var(--space-4) 0; padding-left: 1.1rem; display: grid; gap: var(--space-1); font-size: var(--size--1); }

  .lede { margin-top: calc(-1 * var(--space-4)); margin-bottom: var(--space-7); max-width: 52ch; }
  .route { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: var(--space-5); margin-bottom: var(--space-6); }
  .route li { position: relative; padding-top: var(--space-5); border-top: 1px solid var(--oxblood-200); display: grid; align-content: start; gap: var(--space-1); }
  .route li::before {
    content: ''; position: absolute; top: -5px; left: 0;
    width: 9px; height: 9px; border-radius: 50%; background: var(--oxblood-700);
  }
  .route strong { color: var(--ink-900); font-weight: 600; }
  .route span { font-size: var(--size--1); }

  .quotes { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-7); margin-bottom: var(--space-6); }
  blockquote { font: 500 var(--size-1)/1.4 var(--font-serif); color: var(--oxblood-900); }
  figcaption { margin-top: var(--space-3); font-size: var(--size--1); }
  figcaption a { color: var(--ink-500); }

  .split { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-8); border-top: 1px solid var(--ink-100); }
  .steps { padding-left: 1.25rem; display: grid; gap: var(--space-5); }
  .steps strong { display: block; color: var(--ink-900); font-weight: 600; margin-bottom: var(--space-1); }
  .faq details { border-top: 1px solid var(--ink-100); padding-block: var(--space-4); }
  .faq details:last-child { border-bottom: 1px solid var(--ink-100); }
  .faq summary { cursor: pointer; font-weight: 500; color: var(--ink-900); }
  .faq details p { margin-top: var(--space-3); }

  .close { padding-block: var(--space-8); }
  .close h2 { margin-bottom: 0; }
  .close .actions { margin-top: var(--space-5); }

  .foot { padding-block: var(--space-7) var(--space-9); font-size: var(--size--1); color: var(--ink-500); display: grid; gap: var(--space-3); }
  .foot address { font-style: normal; }
  .foot p { color: var(--ink-500); }

  @media (max-width: 62rem) {
    .bar nav { display: none; }
    .bar .button { margin-left: auto; }
    .route { grid-template-columns: 1fr; gap: 0; border-left: 1px solid var(--oxblood-200); margin-left: 4px; }
    .route li { border-top: 0; padding: 0 0 var(--space-5) var(--space-5); }
    .route li::before { top: 0.45em; left: -5px; }
    .quotes { grid-template-columns: 1fr; gap: var(--space-6); }
  }
  @media (max-width: 48rem) {
    .hero { grid-template-columns: 1fr; gap: var(--space-6); padding-top: var(--space-5); }
    .photo { max-width: 20rem; }
    .services, .split { grid-template-columns: 1fr; gap: var(--space-7); }
  }
</style>
