---
/**
 * Mock B — "Desk". The office's details stay pinned on the left like a business card, so the
 * way to get in touch is always in view; the right column carries the content, sans-serif throughout.
 */
import MockLayout from '@layouts/MockLayout.astro';
import { firm, practices, steps, testimonials } from '@data/site';

const quotes = testimonials.filter((t) => ['Janice Suite', 'Karleen Greenidge'].includes(t.name));
---
<MockLayout title="B · Desk" label="Mock B: Desk">
  <div class="shell">
    <aside class="card">
      <img src="/images/logo.png" alt="Deterville Law Office" width="133" height="100" />
      <p class="who">{firm.lawyer}<br /><span>Barrister &amp; Solicitor, Toronto</span></p>
      <a class="button" href={firm.bookHref}>Book a consultation</a>
      <dl class="contact">
        <div><dt>Phone</dt><dd><a href={firm.phoneHref}>{firm.phone}</a></dd></div>
        <div><dt>WhatsApp</dt><dd><a href={firm.whatsappHref}>Message us</a></dd></div>
        <div><dt>Email</dt><dd><a href={`mailto:${firm.email}`}>{firm.email}</a></dd></div>
        <div><dt>Office</dt><dd>{firm.address.line1}<br />{firm.address.city}</dd></div>
      </dl>
      <nav aria-label="Main">
        <a href="/who-we-are">About</a>
        <a href="/testimonials">Reviews</a>
        <a href="/blog">Blog</a>
        <a href="/contact-us">Contact</a>
      </nav>
    </aside>

    <main class="content">
      <section class="intro">
        <h1>Immigration to Canada and estate planning in Ontario.</h1>
        <p>Meet online from anywhere in the world, or in person in Toronto.</p>
      </section>

      {practices.map((p) => (
        <section class="practice" aria-labelledby={p.slug}>
          <h2 id={p.slug}>{p.title}</h2>
          <p>{p.summary}</p>
          <ul>{p.helpsWith.slice(0, 4).map((h) => <li>{h}</li>)}</ul>
          <a href={p.href}>More on {p.title}</a>
        </section>
      ))}

      <section aria-labelledby="reviews">
        <h2 id="reviews">What clients say</h2>
        <p class="rating">Rated {firm.rating.score} on {firm.rating.source} from {firm.rating.count} reviews.</p>
        {quotes.map((q) => (
          <blockquote>
            <p>{q.quote}</p>
            <footer>{q.name}, {q.source}</footer>
          </blockquote>
        ))}
      </section>

      <section aria-labelledby="start">
        <h2 id="start">Booking takes three steps</h2>
        <ol>{steps.map((s) => <li><strong>{s.title}</strong><span>{s.body}</span></li>)}</ol>
      </section>

      <footer class="foot">
        Law Society of Ontario no. {firm.lsoNumber} · <a href="/legal">Legal &amp; privacy</a>
      </footer>
    </main>
  </div>
</MockLayout>

<style>
  .shell { display: grid; grid-template-columns: minmax(16rem, 22rem) 1fr; min-height: 100vh; }
  a { color: var(--oxblood-700); text-underline-offset: 0.2em; }

  .card {
    position: sticky; top: 0; align-self: start; height: 100vh; overflow-y: auto;
    display: flex; flex-direction: column; gap: var(--space-5);
    padding: var(--space-7) var(--space-6);
    background: var(--oxblood-50); border-right: 1px solid var(--oxblood-100);
  }
  .who { font-weight: 600; color: var(--ink-900); }
  .who span { font-weight: 400; color: var(--ink-500); font-size: var(--size--1); }
  .button {
    display: block; text-align: center; padding: 0.75rem 1rem; border-radius: var(--radius-sm);
    background: var(--oxblood-700); color: var(--paper); font-weight: 500; text-decoration: none;
  }
  .button:hover { background: var(--oxblood-800); }
  .contact { display: grid; gap: var(--space-3); font-size: var(--size--1); }
  .contact dt { color: var(--ink-500); }
  .contact dd { color: var(--ink-900); }
  .card nav { margin-top: auto; display: flex; gap: var(--space-4); flex-wrap: wrap; font-size: var(--size--1); }
  .card nav a { color: var(--ink-700); }

  .content { max-width: 44rem; padding: var(--space-9) var(--layout-gutter); }
  .content > section + section { margin-top: var(--space-8); }
  h1 { font: 600 var(--size-3)/1.2 var(--font-sans); color: var(--ink-900); letter-spacing: -0.01em; max-width: 22ch; }
  .intro p { margin-top: var(--space-4); color: var(--ink-500); font-size: var(--size-1); }
  h2 { font: 600 var(--size-1)/1.3 var(--font-sans); color: var(--ink-900); margin-bottom: var(--space-3); }
  p, li { color: var(--ink-700); }

  .practice { padding-top: var(--space-6); border-top: 1px solid var(--ink-100); }
  .practice ul { margin: var(--space-4) 0; padding-left: 1.1rem; display: grid; gap: var(--space-1); }

  .rating { margin-bottom: var(--space-5); }
  blockquote { border-left: 2px solid var(--oxblood-200); padding-left: var(--space-5); margin-block: var(--space-5); }
  blockquote p { font-size: var(--size-1); color: var(--ink-900); }
  blockquote footer { margin-top: var(--space-2); font-size: var(--size--1); color: var(--ink-500); }

  ol { padding-left: 1.25rem; display: grid; gap: var(--space-4); }
  ol strong { display: block; color: var(--ink-900); font-weight: 600; }

  .foot { margin-top: var(--space-9); font-size: var(--size--1); color: var(--ink-500); }

  @media (max-width: 52rem) {
    .shell { grid-template-columns: 1fr; }
    .card { position: static; height: auto; border-right: 0; border-bottom: 1px solid var(--oxblood-100); }
    .card nav { margin-top: 0; }
    .content { padding-top: var(--space-7); }
  }
</style>
