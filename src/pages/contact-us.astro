---
import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@atoms/Container.astro';
import Button from '@atoms/Button.astro';
import ContactMethod from '@molecules/ContactMethod.astro';
import PageHero from '@organisms/PageHero.astro';
import ContactForm from '@organisms/ContactForm.astro';
import { firm } from '@data/site';
---
<BaseLayout title="Contact Us" description="Contact Deterville Law Office in Toronto for Canadian immigration and estate planning advice. Phone, email, WhatsApp, or online booking.">
  <PageHero title="Contact us" lede="We meet clients wherever they are in the world. Ready to get advice? Book a consultation. Have a quick question first? Send us a message." />

  <section class="contact">
    <Container class="contact-grid">
      <div>
        <h2>Send a message</h2>
        <ContactForm />
      </div>
      <aside class="aside">
        <div class="book">
          <h2>Ready for advice?</h2>
          <p>Book a confidential consultation. You’ll verify your identity and choose how to pay.</p>
          <Button href={firm.bookHref} block>Book a consultation</Button>
        </div>
        <div class="methods">
          <ContactMethod label="Phone" href={firm.phoneHref}>{firm.phone}</ContactMethod>
          <ContactMethod label="WhatsApp" href={firm.whatsappHref}>Message us on WhatsApp</ContactMethod>
          <ContactMethod label="Email" href={`mailto:${firm.email}`}>{firm.email}</ContactMethod>
          <ContactMethod label="Office" href={firm.mapHref}>
            {firm.address.line1}<br />{firm.address.line2}<br />{firm.address.city}
          </ContactMethod>
        </div>
      </aside>
    </Container>
  </section>
</BaseLayout>

<style>
  .contact { padding-block: var(--space-8) var(--layout-section); }
  .contact :global(.contact-grid) { display: grid; gap: var(--space-8); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 62rem) { .contact :global(.contact-grid) { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: var(--space-9); align-items: start; } }
  h2 { font-size: var(--size-3); margin-bottom: var(--space-5); }
  .aside { display: grid; gap: var(--space-7); }
  .book { display: grid; gap: var(--space-4); padding: var(--space-6); background: var(--color-surface-tint); border-radius: var(--radius-sm); }
  .book h2 { font-size: var(--size-2); margin: 0; }
  .book p { color: var(--color-text-muted); }
  .methods { display: grid; gap: var(--space-5); }
</style>
