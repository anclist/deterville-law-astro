---
/**
 * Atom: Button — renders <a> when `href` is set, otherwise <button>.
 * Variants map to intent, not colour: primary = the one action we want, secondary = alternative,
 * ghost = low-emphasis.
 */
import Icon from './Icon.astro';
import type { IconName } from '@lib/icons';

interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'lg' | 'sm';
  icon?: IconName;
  type?: 'button' | 'submit' | 'reset';
  block?: boolean;
  class?: string;
  [key: string]: unknown;
}

const { href, variant = 'primary', size = 'md', icon, type = 'button', block = false, class: className, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---
<Tag
  class:list={['btn', `btn--${variant}`, `btn--${size}`, { 'btn--block': block }, className]}
  href={href}
  type={href ? undefined : type}
  {...rest}
>
  {icon && <Icon name={icon} size={size === 'lg' ? 20 : 18} />}
  <span><slot /></span>
</Tag>

<style>
  .btn {
    --_bg: var(--color-action);
    --_fg: var(--color-action-text);
    --_border: var(--color-action);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: 0.8em 1.5em;
    border: 1.5px solid var(--_border);
    border-radius: var(--radius-sm);
    background: var(--_bg);
    color: var(--_fg);
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--size-0);
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    transition: background var(--motion-fast) var(--motion-ease), border-color var(--motion-fast) var(--motion-ease);
  }

  .btn--primary:hover { --_bg: var(--color-action-hover); --_border: var(--color-action-hover); }

  .btn--secondary { --_bg: transparent; --_fg: var(--color-action); }
  .btn--secondary:hover { --_bg: var(--color-surface-tint); }

  .btn--ghost { --_bg: transparent; --_fg: var(--color-text); --_border: transparent; padding-inline: 0.75em; }
  .btn--ghost:hover { --_bg: var(--color-surface-tint); }

  .btn--sm { font-size: var(--size--1); padding: 0.6em 1.15em; }
  .btn--lg { font-size: var(--size-1); padding: 0.85em 1.6em; }
  .btn--block { display: flex; width: 100%; }
</style>
