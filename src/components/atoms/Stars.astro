---
/** Atom: Stars — rating display. Announces the numeric value; stars are decorative. */
import Icon from './Icon.astro';
interface Props { value: number; max?: number; size?: number }
const { value, max = 5, size = 16 } = Astro.props;
const full = Math.round(value);
---
<span class="stars" role="img" aria-label={`Rated ${value} out of ${max}`}>
  {Array.from({ length: max }, (_, i) => <Icon name="star" size={size} class={i < full ? 'on' : 'off'} />)}
</span>

<style>
  .stars { display: inline-flex; gap: 2px; color: var(--gold-500); }
  .stars :global(.off) { color: var(--ink-100); }
</style>
