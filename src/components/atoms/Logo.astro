---
/** Atom: Logo — the firm's Lady Justice mark with wordmark. Light grounds only. */
interface Props { height?: number }
const { height = 56 } = Astro.props;
---
<img class="logo" src="/images/logo.png" alt="Deterville Law Office" height={height} width={Math.round(height * 1.325)} style={`height:${height}px`} />

<style>
  .logo { width: auto; max-width: none; }
</style>
