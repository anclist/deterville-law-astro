---
/** Organism: QuoteRow — review excerpts in a row of three. Three picked by default, or pass `all`. */
import Container from '@atoms/Container.astro';
import SectionHeading from '@molecules/SectionHeading.astro';
import ReviewQuote from '@molecules/ReviewQuote.astro';
import { testimonials } from '@data/site';

interface Props { all?: boolean; showHeading?: boolean }
const { all = false, showHeading = true } = Astro.props;
const picks = ['Janice Suite', 'Jermael Syahungene', 'Karleen Greenidge'];
const quotes = all ? testimonials : testimonials.filter((t) => picks.includes(t.name));
---
<section class="quotes" aria-labelledby={showHeading ? 'quotes-title' : undefined} aria-label={showHeading ? undefined : 'Client reviews'}>
  <Container>
    {showHeading && <SectionHeading id="quotes-title" title="What clients say" />}
    <div class="grid">
      {quotes.map((t) => <ReviewQuote testimonial={t} />)}
    </div>
    {!all && <p><a class="all" href="/testimonials">Read all reviews</a></p>}
  </Container>
</section>

<style>
  .quotes { padding-block: var(--layout-section); }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-8) var(--space-7); }
  .all { display: inline-block; margin-top: var(--space-6); text-underline-offset: 0.2em; }
  @media (max-width: 62rem) { .grid { grid-template-columns: 1fr; gap: var(--space-6); } }
</style>
