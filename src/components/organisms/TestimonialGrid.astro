---
/** Organism: TestimonialGrid — social proof with the aggregate score up front. */
import Container from '@atoms/Container.astro';
import Button from '@atoms/Button.astro';
import SectionHeading from '@molecules/SectionHeading.astro';
import TestimonialCard from '@molecules/TestimonialCard.astro';
import RatingBadge from '@molecules/RatingBadge.astro';
import { testimonials } from '@data/site';
interface Props { limit?: number; showHeading?: boolean }
const { limit = 3, showHeading = true } = Astro.props;
---
<section class="testimonials" aria-labelledby={showHeading ? 'testimonials-title' : undefined} aria-label={showHeading ? undefined : 'Client reviews'}>
  <Container>
    {showHeading && (
      <SectionHeading id="testimonials-title" title="What clients say">
        <RatingBadge />
      </SectionHeading>
    )}
    <ul class="grid">
      {testimonials.slice(0, limit).map((t) => <li><TestimonialCard testimonial={t} /></li>)}
    </ul>
    {showHeading && limit < testimonials.length && (
      <div class="more"><Button href="/testimonials" variant="secondary">Read more reviews</Button></div>
    )}
  </Container>
</section>

<style>
  .testimonials { padding-block: var(--layout-section-y); }
  .grid { list-style: none; padding: 0; display: grid; gap: var(--space-5); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 48rem) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 68rem) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .more { margin-top: var(--space-7); }
</style>
