---
/**
 * Organism: RouteTimeline — the lawyer's own route to Canada as a plain timeline.
 * Horizontal on wide screens, vertical below 62rem. A real chronology, so it's an <ol>.
 */
import Container from '@atoms/Container.astro';
import SectionHeading from '@molecules/SectionHeading.astro';
import { journey } from '@data/site';

interface Props { title?: string; lede?: string; showLink?: boolean }
const {
  title = 'Her own route to Canada',
  lede = 'Clients moving to Canada work with a lawyer who has made that move herself.',
  showLink = true,
} = Astro.props;
---
<section class="route-section" aria-labelledby="route-title">
  <Container>
    <SectionHeading id="route-title" title={title} lede={lede} />
    <ol class="route">
      {journey.map((j) => (
        <li><strong>{j.place}</strong><span>{j.detail}</span></li>
      ))}
    </ol>
    {showLink && <p><a href="/who-we-are">Read her full biography</a></p>}
  </Container>
</section>

<style>
  .route-section { background: var(--color-surface-tint); padding-block: var(--layout-section); }
  .route { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: var(--space-5); }
  .route li {
    position: relative; display: grid; align-content: start; gap: var(--space-1);
    padding-top: var(--space-5); border-top: 1px solid var(--oxblood-200);
  }
  .route li::before {
    content: ''; position: absolute; top: -5px; left: 0;
    width: 9px; height: 9px; border-radius: 50%; background: var(--color-action);
  }
  strong { font-weight: 600; }
  span { font-size: var(--size--1); color: var(--color-text-muted); }
  p { margin-top: var(--space-6); }
  a { text-underline-offset: 0.2em; }

  @media (max-width: 62rem) {
    .route { grid-template-columns: 1fr; gap: 0; border-left: 1px solid var(--oxblood-200); margin-left: 4px; }
    .route li { border-top: 0; padding: 0 0 var(--space-5) var(--space-5); }
    .route li::before { top: 0.45em; left: -5px; }
  }
</style>
