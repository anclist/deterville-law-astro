---
/** Organism: SiteHeader — sticky; the booking action is always one click away. */
import Logo from '@atoms/Logo.astro';
import Button from '@atoms/Button.astro';
import Icon from '@atoms/Icon.astro';
import { nav, firm } from '@data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href + '/'));
---
<header class="site-header" data-header>
  <div class="bar">
    <a href="/" class="brand" aria-label="Deterville Law Office, home"><Logo height={52} /></a>

    <nav class="nav" id="site-nav" aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
      <div class="nav-mobile-actions">
        <Button href={firm.bookHref} block>Book a consultation</Button>
        <Button href={firm.phoneHref} variant="secondary" icon="phone" block>Call {firm.phone}</Button>
      </div>
    </nav>

    <div class="actions">
      <a class="phone" href={firm.phoneHref}><Icon name="phone" size={18} />{firm.phone}</a>
      <Button href={firm.bookHref} size="sm">Book a consultation</Button>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
        <span class="visually-hidden">Menu</span>
        <Icon name="menu" size={24} class="i-open" />
        <Icon name="close" size={24} class="i-close" />
      </button>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const header = document.querySelector<HTMLElement>('[data-header]');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    header?.toggleAttribute('data-open', !open);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && header?.hasAttribute('data-open')) {
      header.removeAttribute('data-open');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.focus();
    }
  });
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: rgb(255 255 255 / 0.94);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--color-border);
  }
  .bar {
    max-width: var(--layout-container); margin-inline: auto;
    padding: var(--space-3) var(--layout-gutter);
    display: flex; align-items: center; gap: var(--space-5);
  }
  .brand { flex: none; }
  .nav { margin-left: auto; }
  .nav ul { list-style: none; padding: 0; display: flex; gap: var(--space-1); }
  .nav ul a {
    display: block; padding: var(--space-2) var(--space-3);
    color: var(--color-text); text-decoration: none; font-weight: 500; font-size: var(--size--1); white-space: nowrap;
    border-radius: var(--radius-sm);
  }
  .nav ul a:hover { color: var(--color-action); background: var(--color-surface-tint); }
  .nav ul a[aria-current='page'] { color: var(--color-action); box-shadow: inset 0 -2px 0 var(--color-action); border-radius: 0; }
  .nav-mobile-actions { display: none; }
  .actions { display: flex; align-items: center; gap: var(--space-4); }
  .phone { display: inline-flex; gap: var(--space-2); align-items: center; font-weight: 600; font-size: var(--size--1); color: var(--color-text); text-decoration: none; white-space: nowrap; }
  .phone:hover { color: var(--color-action); }
  .menu-toggle { display: none; background: none; border: 0; padding: var(--space-2); color: var(--color-heading); }
  .menu-toggle :global(.i-close) { display: none; }

  @media (max-width: 78rem) { .phone { display: none; } }

  @media (max-width: 64rem) {
    .menu-toggle { display: inline-flex; }
    .actions { margin-left: auto; }
    .nav {
      display: none;
      position: absolute; inset: 100% 0 auto 0;
      background: var(--color-surface);
      border-bottom: 1px solid var(--color-border);
      box-shadow: var(--shadow-raised);
      padding: var(--space-4) var(--layout-gutter) var(--space-6);
      max-height: calc(100dvh - 5rem); overflow-y: auto;
    }
    .nav ul { flex-direction: column; }
    .nav ul a { font-size: var(--size-1); padding: var(--space-3) 0; border-bottom: 1px solid var(--color-border); border-radius: 0; }
    .nav ul a[aria-current='page'] { box-shadow: none; }
    .nav-mobile-actions { display: grid; gap: var(--space-3); margin-top: var(--space-5); }
    .site-header[data-open] .nav { display: block; }
    .site-header[data-open] :global(.i-open) { display: none; }
    .site-header[data-open] :global(.i-close) { display: inline-block; }
  }
  @media (max-width: 30rem) {
    .actions :global(.btn) { display: none; }
  }
</style>
