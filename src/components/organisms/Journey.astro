---
/**
 * Organism: Journey — the page's signature moment.
 * The lawyer's own route to Canada, drawn as a route line. It is the firm's real point of
 * difference for immigration clients, so it gets the boldest treatment on the site.
 * The gold line draws once as it scrolls into view (scroll-driven; static where unsupported).
 */
import Container from '@atoms/Container.astro';
import Button from '@atoms/Button.astro';
import { journey } from '@data/site';
interface Props { showLink?: boolean }
const { showLink = true } = Astro.props;
---
<section class="journey" aria-labelledby="journey-title">
  <Container>
    <div class="intro">
      <h2 id="journey-title">Your lawyer has made this move too.</h2>
      <p>
        Ms Deterville has lived in five countries besides her homeland of Saint Lucia and has been called to
        three Bars. That lived immigrant experience is why she works with people making Canada their home.
      </p>
    </div>

    <ol class="route">
      {journey.map((stop, i) => (
        <li class:list={['stop', { 'stop--last': i === journey.length - 1 }]}>
          <span class="dot" aria-hidden="true" />
          <span class="place">{stop.place}</span>
          <span class="detail">{stop.detail}</span>
        </li>
      ))}
    </ol>

    {showLink && (
      <div class="cta">
        <Button href="/who-we-are" variant="inverse">Read Ms Deterville’s story</Button>
      </div>
    )}
  </Container>
</section>

<style>
  .journey {
    background: var(--color-surface-inverse);
    color: var(--color-text-inverse);
    padding-block: var(--layout-section-y);
    overflow: hidden;
  }
  .intro { display: grid; gap: var(--space-5); max-width: 46rem; margin-bottom: var(--space-8); }
  h2 { color: var(--color-text-inverse); font-size: var(--size-6); letter-spacing: -0.015em; }
  .intro p { font-size: var(--size-1); line-height: var(--leading-snug); color: var(--color-text-inverse-muted); max-width: 52ch; }

  .route {
    --dot: 1rem;
    list-style: none; padding: 0;
    display: grid; gap: var(--space-6);
    position: relative;
  }
  /* The route line */
  .route::before {
    content: '';
    position: absolute;
    left: calc(var(--dot) / 2 - 1px); top: 0.6rem; bottom: 0.6rem;
    width: 2px;
    background: linear-gradient(var(--gold-500), var(--gold-500)) no-repeat top / 100% var(--drawn, 100%), rgb(255 255 255 / 0.15);
  }
  .stop { position: relative; display: grid; gap: var(--space-1); padding-left: calc(var(--dot) + var(--space-5)); }
  .dot {
    position: absolute; left: 0; top: 0.55em;
    width: var(--dot); height: var(--dot); border-radius: 50%;
    background: var(--color-surface-inverse);
    border: 2px solid var(--gold-500);
  }
  .stop--last .dot { background: var(--gold-500); box-shadow: 0 0 0 6px rgb(232 184 74 / 0.2); }
  .place { font-family: var(--font-heading); font-size: var(--size-3); line-height: 1.1; }
  .stop--last .place { color: var(--gold-300); }
  .detail { color: var(--color-text-inverse-muted); font-size: var(--size--1); max-width: 30ch; }

  @media (min-width: 60rem) {
    .route { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: var(--space-5); }
    .route::before {
      left: 0.5rem; right: 0; top: calc(var(--dot) / 2 - 1px); bottom: auto;
      width: auto; height: 2px;
      background: linear-gradient(var(--gold-500), var(--gold-500)) no-repeat left / var(--drawn, 100%) 100%, rgb(255 255 255 / 0.15);
    }
    .stop { padding-left: 0; padding-top: calc(var(--dot) + var(--space-5)); }
    .dot { top: 0; }
  }

  .cta { margin-top: var(--space-8); }

  @property --drawn { syntax: '<percentage>'; inherits: false; initial-value: 100%; }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .route::before {
        animation: draw linear both;
        animation-timeline: view();
        animation-range: entry 20% cover 45%;
      }
      @keyframes draw { from { --drawn: 0%; } to { --drawn: 100%; } }
    }
  }
</style>
