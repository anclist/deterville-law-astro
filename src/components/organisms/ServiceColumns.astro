---
/** Organism: ServiceColumns — practices side by side, each with what it covers. `exclude` drops the current one. */
import Container from '@atoms/Container.astro';
import SectionHeading from '@molecules/SectionHeading.astro';
import { practices } from '@data/site';

interface Props { title?: string; exclude?: string }
const { title = 'How we can help', exclude } = Astro.props;
const shown = practices.filter((p) => p.slug !== exclude);
---
<section class="services" aria-labelledby="services-title">
  <Container>
    <SectionHeading id="services-title" title={title} />
    <div class="grid" style={`--cols:${shown.length}`}>
      {shown.map((p) => (
        <div class="service">
          <h3><a href={p.href}>{p.title}</a></h3>
          <p>{p.short}</p>
          <ul>{p.helpsWith.slice(0, 3).map((h) => <li>{h}</li>)}</ul>
          <a class="more" href={p.href}>More on {p.title}</a>
        </div>
      ))}
    </div>
  </Container>
</section>

<style>
  .services { padding-block: var(--layout-section); }
  .grid { display: grid; grid-template-columns: repeat(var(--cols), 1fr); gap: var(--space-7); }
  .service { border-top: 2px solid var(--color-action); padding-top: var(--space-5); max-width: 28rem; }
  h3 { font-size: var(--size-2); margin-bottom: var(--space-3); }
  h3 a { color: var(--color-text); text-decoration: none; }
  h3 a:hover { color: var(--color-action); text-decoration: underline; }
  ul { margin: var(--space-4) 0; padding-left: 1.1rem; display: grid; gap: var(--space-1); font-size: var(--size--1); }
  .more { text-underline-offset: 0.2em; }
  @media (max-width: 48rem) { .grid { grid-template-columns: 1fr; } }
</style>
