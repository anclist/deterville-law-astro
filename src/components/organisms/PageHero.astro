---
/** Organism: PageHero — inner page header on white: title, lede, optional actions slot. */
import Container from '@atoms/Container.astro';
interface Props { title: string; lede?: string }
const { title, lede } = Astro.props;
---
<section class="page-hero">
  <Container>
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
    {Astro.slots.has('default') && <div class="extra"><slot /></div>}
  </Container>
</section>

<style>
  .page-hero { padding-block: var(--space-8) var(--space-7); border-bottom: 1px solid var(--color-border); }
  h1 { font-size: var(--size-4); line-height: 1.05; max-width: 22ch; }
  .lede { margin-top: var(--space-4); font-size: var(--size-1); line-height: var(--leading-snug); color: var(--color-text-muted); max-width: 54ch; }
  .extra { margin-top: var(--space-6); display: flex; flex-wrap: wrap; gap: var(--space-5); align-items: center; }
</style>
