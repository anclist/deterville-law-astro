---
/** Organism: MobileActionBar — thumb-reach contact actions on small screens. */
import Icon from '@atoms/Icon.astro';
import { firm } from '@data/site';
---
<nav class="mobile-bar" aria-label="Quick contact">
  <a href={firm.phoneHref}><Icon name="phone" size={20} />Call</a>
  <a href={firm.whatsappHref} target="_blank" rel="noopener"><Icon name="whatsapp" size={20} />WhatsApp</a>
  <a href={firm.bookHref} class="primary">Book a consultation</a>
</nav>

<style>
  .mobile-bar { display: none; }
  @media (max-width: 48rem) {
    .mobile-bar {
      position: fixed; inset: auto 0 0 0; z-index: 40;
      display: grid; grid-template-columns: auto auto 1fr; gap: var(--space-2);
      padding: var(--space-2) var(--space-3) calc(var(--space-2) + env(safe-area-inset-bottom));
      background: var(--color-surface);
      border-top: 1px solid var(--color-border);
      box-shadow: 0 -8px 24px -16px rgb(61 3 3 / 0.3);
    }
    a {
      display: inline-flex; align-items: center; justify-content: center; gap: var(--space-2);
      padding: var(--space-3) var(--space-3);
      border-radius: var(--radius-pill);
      font-weight: 600; font-size: var(--size--1); text-decoration: none; color: var(--color-action);
      border: 1.5px solid var(--color-border-strong);
    }
    .primary { background: var(--color-action); color: var(--color-action-text); border-color: var(--color-action); }
  }
</style>
