---
/** Organism: BookingFaq — the booking steps beside the questions people ask before booking. */
import Container from '@atoms/Container.astro';
import SectionHeading from '@molecules/SectionHeading.astro';
import Step from '@molecules/Step.astro';
import FaqItem from '@molecules/FaqItem.astro';
import { steps, faqs } from '@data/site';
---
<section class="booking" aria-label="Booking and common questions">
  <Container class="booking__grid">
    <div>
      <SectionHeading id="steps-title" title="Booking takes three steps" />
      <ol class="steps">
        {steps.map((s) => <Step title={s.title}>{s.body}</Step>)}
      </ol>
    </div>
    <div>
      <SectionHeading id="faq-title" title="Common questions" />
      <div class="faq">
        {faqs.map((f) => <FaqItem question={f.q}><p>{f.a}</p></FaqItem>)}
      </div>
    </div>
  </Container>
</section>

<style>
  .booking { padding-block: var(--layout-section); border-top: 1px solid var(--color-border); }
  .booking :global(.booking__grid) { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-8); }
  .steps { padding-left: 1.25rem; display: grid; gap: var(--space-5); }
  .faq { border-top: 1px solid var(--color-border); }
  @media (max-width: 48rem) { .booking :global(.booking__grid) { grid-template-columns: 1fr; gap: var(--space-7); } }
</style>
