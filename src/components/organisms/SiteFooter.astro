---
/**
 * Organism: SiteFooter — the one dark surface on a page, so it reads unmistakably as the end.
 * Text only: firm summary, services, firm pages, contact, socials and the regulatory notice.
 */
import Container from '@atoms/Container.astro';
import { firm, practices, socials } from '@data/site';

const year = new Date().getFullYear();
const firmLinks = [
  { label: 'Who we are', href: '/who-we-are' },
  { label: 'Testimonials', href: '/testimonials' },
  { label: 'Blog', href: '/blog' },
  { label: 'Media & appearances', href: '/media' },
  { label: 'Consultation documents', href: '/consultation-documents' },
];
---
<footer class="site-footer">
  <Container>
    <div class="grid">
      <div class="brand">
        <p class="name">{firm.name}</p>
        <p>{firm.tagline}. Online consultations worldwide, and in person in Toronto.</p>
        <p>Rated {firm.rating.score} on {firm.rating.source} from {firm.rating.count} reviews</p>
      </div>
      <nav aria-labelledby="footer-services">
        <h2 id="footer-services">Services</h2>
        <ul>{practices.map((p) => <li><a href={p.href}>{p.title}</a></li>)}</ul>
      </nav>
      <nav aria-labelledby="footer-firm">
        <h2 id="footer-firm">The firm</h2>
        <ul>{firmLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
      <div>
        <h2>Contact</h2>
        <ul>
          <li><a href={firm.phoneHref}>{firm.phone}</a></li>
          <li><a href={firm.whatsappHref}>WhatsApp</a></li>
          <li><a href={`mailto:${firm.email}`}>{firm.email}</a></li>
          <li><a href={firm.mapHref}>{firm.address.line1}<br />{firm.address.city}</a></li>
        </ul>
      </div>
    </div>

    <div class="bottom">
      <ul class="socials" aria-label="Social media">
        {socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}
      </ul>
      <p>
        Deterville Law Office is a registered business name of Nandi Ayodele Olivia Deterville, licensee of the Law Society
        of Ontario ({firm.lsoNumber}). Information on this site is general and is not legal advice. Contacting us does not
        create a lawyer–client relationship.
      </p>
      <p>© {year} Deterville Law Office · <a href="/legal">Legal &amp; privacy</a> · <a href="/styleguide">Styleguide</a></p>
    </div>
  </Container>
</footer>

<style>
  .site-footer {
    background: var(--color-surface-inverse); color: var(--color-text-inverse-muted);
    padding-block: var(--space-8) var(--space-7); font-size: var(--size--1);
    --color-focus: var(--paper);
  }
  p { color: var(--color-text-inverse-muted); }
  a { color: var(--color-text-inverse); text-decoration: none; }
  a:hover { text-decoration: underline; }
  h2 { font: 600 var(--size--1)/1.3 var(--font-body); color: var(--color-text-inverse-muted); margin-bottom: var(--space-4); }
  ul { list-style: none; padding: 0; display: grid; gap: var(--space-3); }
  .grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1.2fr; gap: var(--space-7); }
  .brand { display: grid; gap: var(--space-3); align-content: start; max-width: 32ch; }
  .name { font: 500 var(--size-2)/1.2 var(--font-heading); color: var(--color-text-inverse); }
  .bottom { margin-top: var(--space-8); padding-top: var(--space-5); border-top: 1px solid rgb(255 255 255 / 0.14); display: grid; gap: var(--space-3); }
  .socials { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); margin-bottom: var(--space-2); }
  .bottom p { font-size: var(--size--2); max-width: 90ch; }

  @media (max-width: 62rem) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 36rem) { .grid { grid-template-columns: 1fr; } }
</style>
