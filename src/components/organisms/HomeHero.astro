---
/**
 * Organism: HomeHero — a one-lawyer practice, so the page opens with the lawyer: her photograph,
 * her name and her route to Canada. One primary action, one alternative, then quiet proof.
 */
import Container from '@atoms/Container.astro';
import Button from '@atoms/Button.astro';
import { firm } from '@data/site';
---
<section class="hero" aria-labelledby="hero-title">
  <Container class="hero__grid">
    <img class="photo" src="/images/nandi-deterville.jpg" alt="Nandi Deterville" width="899" height="1200" fetchpriority="high" />
    <div class="text">
      <h1 id="hero-title">Nandi Deterville</h1>
      <p class="role">Canadian immigration and Ontario estate planning lawyer, Toronto</p>
      <p>
        Born and raised in Saint Lucia, called to the Bar in England, Saint Lucia and Ontario. Having lived in five
        countries other than her homeland, she has navigated each one’s immigration rules, and that experience shapes
        her work with people who want to make Canada their home.
      </p>
      <p>She also helps Ontario families put Wills and Powers of Attorney in place, and provides notarial services.</p>
      <div class="actions">
        <Button href={firm.bookHref} size="lg">Book a consultation</Button>
        <a class="alt" href={firm.whatsappHref}>Message on WhatsApp</a>
      </div>
      <p class="trust">
        Rated {firm.rating.score} on {firm.rating.source} from {firm.rating.count} reviews ·
        Law Society of Ontario no. {firm.lsoNumber} · Consultations online, worldwide
      </p>
    </div>
  </Container>
</section>

<style>
  .hero { padding-block: var(--space-8); }
  .hero :global(.hero__grid) { display: grid; grid-template-columns: 5fr 7fr; gap: var(--space-8); align-items: center; }
  .photo { width: 100%; height: auto; aspect-ratio: 3 / 4; object-fit: cover; border-radius: var(--radius-sm); }
  h1 { font-size: var(--size-4); font-weight: 500; line-height: 1.05; }
  .role { margin-top: var(--space-3); font-size: var(--size-1); color: var(--color-text-muted); }
  .text > p:not(.role) { margin-top: var(--space-5); max-width: 52ch; }
  .text > .trust { font-size: var(--size--1); color: var(--color-text-muted); }
  .actions { display: flex; align-items: center; gap: var(--space-5); flex-wrap: wrap; margin-top: var(--space-6); }
  .alt { font-weight: 500; color: var(--color-action); text-underline-offset: 0.2em; }

  @media (max-width: 48rem) {
    .hero { padding-top: var(--space-5); }
    .hero :global(.hero__grid) { grid-template-columns: 1fr; gap: var(--space-6); }
    .photo { max-width: 20rem; }
  }
</style>
