---
/** Molecule: RatingBadge — the aggregate review score as one plain sentence, linking to the source. */
import { firm } from '@data/site';
const { score, count, source } = firm.rating;
---
<a class="rating" href={firm.mapHref} target="_blank" rel="noopener">
  Rated <strong>{score}</strong> on {source} from {count} reviews
</a>

<style>
  .rating { font-size: var(--size--1); color: var(--color-text-muted); text-underline-offset: 0.2em; }
  strong { font-weight: 600; color: var(--color-text); }
</style>
