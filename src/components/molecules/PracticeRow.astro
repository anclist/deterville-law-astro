---
/**
 * Molecule: PracticeRow — one practice area as a full-width row, not a card.
 * Title links to the practice page; the list says concretely what we help with.
 */
import Icon from '@atoms/Icon.astro';
import Button from '@atoms/Button.astro';
import type { Practice } from '@data/site';

interface Props { practice: Practice; limit?: number }
const { practice, limit = 3 } = Astro.props;
---
<article class="practice-row">
  <h3><a href={practice.href}>{practice.title}</a></h3>
  <div class="body">
    <p class="summary">{practice.summary}</p>
    <ul>
      {practice.helpsWith.slice(0, limit).map((item) => (
        <li><Icon name="check" size={18} />{item}</li>
      ))}
    </ul>
  </div>
  <div class="action">
    <Button href={practice.href} variant="secondary" size="sm">More on {practice.title}</Button>
  </div>
</article>

<style>
  .practice-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-border);
  }
  .practice-row:last-child { border-bottom: 1px solid var(--color-border); }
  h3 { font-size: var(--size-3); }
  h3 a { color: inherit; text-decoration: none; }
  h3 a:hover { color: var(--color-action); }
  .summary { max-width: var(--measure-prose); color: var(--color-text); }
  ul { list-style: none; padding: 0; margin-top: var(--space-4); display: grid; gap: var(--space-2); }
  li { display: flex; gap: var(--space-2); align-items: flex-start; color: var(--color-text-muted); }
  li :global(.icon) { color: var(--color-action); margin-top: 0.2em; }

  @media (min-width: 60rem) {
    .practice-row { grid-template-columns: 17rem minmax(0, 1fr) auto; gap: var(--space-7); align-items: start; }
    .action { padding-top: var(--space-2); }
  }
</style>
