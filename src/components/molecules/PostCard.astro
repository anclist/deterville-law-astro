---
/** Molecule: PostCard — blog teaser. Whole card is one link target via the title. */
import Tag from '@atoms/Tag.astro';
interface Props { href: string; title: string; description: string; date: Date; category: string; image?: string; imageAlt?: string; headingLevel?: 'h2' | 'h3' }
const { href, title, description, date, category, image, imageAlt = '', headingLevel: H = 'h3' } = Astro.props;
const fmt = date.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<article class="post-card">
  {image && <img src={image} alt={imageAlt} loading="lazy" width="640" height="400" />}
  <div class="meta">
    <Tag tone={category === 'Immigration' ? 'immigration' : 'estates'}>{category}</Tag>
    <time datetime={date.toISOString()}>{fmt}</time>
  </div>
  <H class="title"><a href={href}>{title}</a></H>
  <p>{description}</p>
</article>

<style>
  .post-card { position: relative; display: grid; gap: var(--space-3); align-content: start; }
  img { aspect-ratio: 16 / 10; object-fit: cover; width: 100%; border-radius: var(--radius-md); background: var(--color-surface-sunken); }
  .meta { display: flex; gap: var(--space-3); align-items: center; font-size: var(--size--1); color: var(--color-text-muted); }
  .title { font-size: var(--size-2); line-height: var(--leading-snug); }
  .title a { color: inherit; text-decoration: none; }
  .title a::after { content: ''; position: absolute; inset: 0; }
  .post-card:hover .title a { color: var(--color-action); text-decoration: underline; text-decoration-thickness: 1px; }
  .post-card:has(a:focus-visible) { outline: 3px solid var(--color-focus); outline-offset: 6px; border-radius: var(--radius-md); }
  .title a:focus-visible { outline: none; }
  p { color: var(--color-text-muted); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
</style>
