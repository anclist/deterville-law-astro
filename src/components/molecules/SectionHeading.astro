---
/** Molecule: SectionHeading — h2 + optional lede. Left-aligned by default; no eyebrow labels. */
interface Props { title: string; lede?: string; align?: 'start' | 'center'; tone?: 'default' | 'inverse'; size?: 'lg' | 'md'; id?: string }
const { title, lede, align = 'start', tone = 'default', size = 'lg', id } = Astro.props;
---
<header class:list={['section-heading', `section-heading--${align}`, `section-heading--${tone}`, `section-heading--${size}`]}>
  <h2 id={id}>{title}</h2>
  {lede && <p class="lede">{lede}</p>}
  <slot />
</header>

<style>
  .section-heading { display: grid; gap: var(--space-4); max-width: 44rem; margin-bottom: var(--space-7); }
  .section-heading--center { margin-inline: auto; text-align: center; justify-items: center; }
  h2 { font-size: var(--size-5); letter-spacing: -0.01em; }
  .lede { font-size: var(--size-1); line-height: var(--leading-snug); color: var(--color-text-muted); max-width: var(--measure-narrow); }
  .section-heading--md { gap: var(--space-3); margin-bottom: var(--space-6); }
  .section-heading--md h2 { font-size: var(--size-3); font-weight: 500; letter-spacing: 0; }
  .section-heading--md .lede { font-size: var(--size-0); line-height: var(--leading-body); }
  .section-heading--inverse h2 { color: var(--color-text-inverse); }
  .section-heading--inverse .lede { color: var(--color-text-inverse-muted); }
</style>
