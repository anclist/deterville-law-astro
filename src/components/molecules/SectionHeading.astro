---
/** Molecule: SectionHeading — h2 + optional lede. Left-aligned, no eyebrow labels. */
interface Props { title: string; lede?: string; id?: string }
const { title, lede, id } = Astro.props;
---
<header class="section-heading">
  <h2 id={id}>{title}</h2>
  {lede && <p class="lede">{lede}</p>}
  <slot />
</header>

<style>
  .section-heading { display: grid; gap: var(--space-3); max-width: 44rem; margin-bottom: var(--space-6); }
  h2 { font-size: var(--size-3); }
  .lede { color: var(--color-text-muted); max-width: 52ch; }
</style>
