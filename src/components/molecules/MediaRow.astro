---
/** Molecule: MediaRow — one appearance, article or directory entry. */
import Icon from '@atoms/Icon.astro';
import type { MediaItem } from '@data/media';
interface Props { item: MediaItem }
const { title, role, date, href } = Astro.props.item;
const fmt = date ? new Date(date).toLocaleDateString('en-CA', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' }) : undefined;
---
<li class="media-row">
  {fmt ? <time datetime={date}>{fmt}</time> : <span class="no-date" />}
  <div>
    <p class="title">
      {href ? <a href={href} target="_blank" rel="noopener">{title}<Icon name="external" size={14} /></a> : title}
    </p>
    {role && <p class="role">{role}</p>}
  </div>
</li>

<style>
  .media-row { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-1); padding-block: var(--space-4); border-top: 1px solid var(--color-border); }
  time { font-size: var(--size--1); color: var(--color-text-muted); font-variant-numeric: tabular-nums; }
  .title { font-weight: 600; }
  .title a { display: inline; color: var(--color-text); }
  .title a:hover { color: var(--color-action); }
  .title :global(.icon) { display: inline; margin-left: 0.3em; color: var(--color-text-muted); }
  .role { color: var(--color-text-muted); font-size: var(--size--1); }
  @media (min-width: 40rem) {
    .media-row { grid-template-columns: 8.5rem minmax(0, 1fr); gap: var(--space-5); }
    time { padding-top: 0.15em; }
  }
</style>
